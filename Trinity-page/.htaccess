# ══════════════════════════════════════════════════════════
#  TRINITY — .htaccess del front-end (Trinity-page/)
#  Requiere AllowOverride All (ver docker/apache.conf en Docker o
#  scripts/server/trinity.conf en un servidor propio).
# ══════════════════════════════════════════════════════════

# ── Página 404 personalizada ──────────────────────────────
ErrorDocument 404 /pages/errors/404.html

# ── Archivos sensibles ─────────────────────────────────────
# vendor/, database/, scripts/ y docker/ ya no están dentro de Trinity-page/
# (viven en la raíz del proyecto, fuera del DocumentRoot), así que no hace
# falta bloquearlos acá. La API (app/) se expone aparte con `Alias /app` y se
# protege en el vhost. Esto queda como red de seguridad por si algún día
# aparece un archivo de configuración o un SQL dentro del front.
<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|.*\.sql)$">
    Require all denied
</FilesMatch>
