#  cp .env.example .env        (Windows:  copy .env.example .env)
#
#  UN solo archivo para los dos modos de uso:
#    · Con Docker:  lo lee docker-compose.yml (y pasa a cada contenedor solo lo
#                   que corresponde). Las secciones "Solo sin Docker" se ignoran.
#    · Sin Docker:  PHP lo lee de la raíz del proyecto (app/config.php) y los
#                   scripts de scripts/server/ también.
#  El bot de WhatsApp (WhatsApp/) corre aparte y tiene su propio WhatsApp/.env.example.
#
#  Los valores de abajo son SOLO para desarrollo/defensa en tu máquina.
#  Si vas a exponer el sistema en una red, cambiá TODAS las contraseñas
#  (ej.: openssl rand -hex 16). Evitá los caracteres  $  y  "  en ellas,
#  porque Docker Compose los interpreta dentro del .env.
#  El archivo .env real NUNCA se sube a git (está en .gitignore).

APP_PORT=8080
APP_URL=http://localhost:8080

DB_NAME=trinity
DB_USER=trinity_app
DB_ROOT_PASS=trinity_root_dev_2026
DB_PASS=trinity_app_dev_2026
DB_READONLY_PASS=trinity_readonly_dev_2026
DB_BACKUP_PASS=trinity_backup_dev_2026
DB_MIGRATOR_PASS=trinity_migrator_dev_2026

# 1 = al primer arranque cargar los datos de prueba (64 usuarios, 56 torneos, etc.)
# 0 = base vacía, solo estructura
LOAD_SEED=1

BREVO_KEY=
ADMIN_KEY=
FNKEY=

WA_SECRET=
WA_BOT_URL=http://whatsapp:3001

# ── Herramientas de desarrollo (docker compose --profile dev up -d) ──
ADMINER_PORT=8081

# ══ Solo SIN Docker (servidor tradicional) ══════════════════════════
# Con Docker el compose define estas variables por su cuenta: no hace falta tocarlas.
DB_HOST=localhost
DB_PORT=3306
# (Opcional) Si WA_BOT_URL queda vacía, se arma con host:puerto.
WA_BOT_HOST=127.0.0.1
WA_BOT_PORT=3001
# (Opcional) Carpeta con las imágenes del sitio para leerlas del disco en vez
# de pedírselas al bot, ej.: /var/www/trinity/WhatsApp/assets
ASSETS_DIR=
# Solo para scripts/server/wacheck.sh (aviso si el bot se cae)
ALERT_PHONE=
ALERT_EMAIL=
ALERT_NAME=
